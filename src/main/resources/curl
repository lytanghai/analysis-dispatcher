JOB
1. Save New Cron Job
curl --request POST \
  --url http://localhost:8081/job/create \
  --header 'Content-Type: application/json' \
  --header 'User-Agent: insomnia/10.1.1' \
  --data '{
	"job_name": "XAU_SPOT_PRICE_UPDATE",
	"cron_expression": "* * * * 1-5"
}'

2. Update
curl --request POST \
  --url https://analysis-dispatcher.onrender.com/job/update \
  --header 'Content-Type: application/json' \
  --header 'User-Agent: insomnia/10.1.1' \
  --data '{
	"id": 4,
	"cron_expression": "0 0 1 * * *"
}'

3. List
curl --request POST \
  --url https://analysis-dispatcher.onrender.com/job/list \
  --header 'Content-Type: application/json' \
  --header 'User-Agent: insomnia/10.1.1' \
  --data '{
	"id":"",
	"job_name":"",
	"enabled": true
}'

4. Delete
curl --request POST \
  --url https://analysis-dispatcher.onrender.com/job/delete \
  --header 'Content-Type: application/json' \
  --header 'User-Agent: insomnia/10.1.1' \
  --data '{
	"id": 12
}'
